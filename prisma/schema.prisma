generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DESCARTADOR
  ONG_MEMBER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(DESCARTADOR)
  points       Int      @default(0)
  level        Int      @default(1)
  avatarUrl    String?
  // Incrementado a cada logout para invalidar tokens antigos
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@map("users")
}
