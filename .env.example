# Banco de dados (Prisma) — bate com o docker-compose
# Use 127.0.0.1 e nao "localhost": no Windows o localhost resolve para IPv6 (::1)
# primeiro, e o Docker publica a porta so em IPv4 — dá timeout de conexao.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ewaste-db?schema=public"
# Use a conexão direta para migrations. No Docker local, as duas URLs são iguais.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/ewaste-db?schema=public"

# JWT — troque por um segredo longo e aleatorio
# Gerar um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES="7d"

# Porta da API
PORT=3000
NODE_ENV=development

# Origens web fora do ambiente de desenvolvimento, separadas por vírgula
CORS_ORIGINS=

# Opcional: configure as duas variáveis para criar a conta admin pelo seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=

# Opcional: só em desenvolvimento. Sem senha, o seed não cria a ONG de demonstração.
SEED_DEMO_ONG_SENHA=
